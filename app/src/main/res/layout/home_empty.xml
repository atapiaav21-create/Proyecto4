<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Fondo superior -->
    <View
        android:id="@+id/homeEmptyBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#5BC0EB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.38"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtHomeEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="45dp"
        android:text="Inicio"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Perfil -->
    <ImageView
        android:id="@+id/imgProfileEmpty"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="60dp"
        android:contentDescription="Imagen de perfil"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtHomeEmpty" />

    <!-- Notificaciones -->
    <TextView
        android:id="@+id/txtNotificationEmpty"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="🔔"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtHomeEmpty" />

    <!-- Saludo -->
    <TextView
        android:id="@+id/txtGreetingEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="25dp"
        android:text="Hola, Adrián"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHomeEmpty" />

    <!-- Balance -->
    <TextView
        android:id="@+id/txtBalanceEmptyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:text="Balance"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtGreetingEmpty" />

    <TextView
        android:id="@+id/txtBalanceEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="$0"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtBalanceEmptyLabel" />

    <!-- Botón enviar -->
    <Button
        android:id="@+id/btnSendMoneyEmpty"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#43A047"
        android:text="Enviar dinero"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toStartOf="@id/btnAddMoneyEmpty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtBalanceEmpty" />

    <!-- Botón ingresar -->
    <Button
        android:id="@+id/btnAddMoneyEmpty"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="#5BC0EB"
        android:text="Ingresar dinero"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSendMoneyEmpty"
        app:layout_constraintTop_toTopOf="@id/btnSendMoneyEmpty" />

    <!-- Sección sin transacciones -->
    <TextView
        android:id="@+id/txtNoTransactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:text="Aún no tienes transacciones"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSendMoneyEmpty" />

    <TextView
        android:id="@+id/txtNoTransactionsDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="Cuando realices una operación, tus transacciones aparecerán aquí."
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNoTransactions" />

</androidx.constraintlayout.widget.ConstraintLayout>